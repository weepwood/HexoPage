<article class="article"><header class="article-head"><a class="back" href="<%= url_for('/archives/') %>">← 文章归档</a><h1><%= page.title %></h1><div class="article-meta"><time datetime="<%= date(page.date,'YYYY-MM-DD') %>"><%= date(page.date,'YYYY.MM.DD') %></time><% page.categories.forEach(function(c){ %><a href="<%= url_for(c.path) %>"><%= c.name %></a><% }) %></div></header><% const tocHtml=toc(page.content,{list_number:false}); if(tocHtml){ %><details class="toc"><summary>文章目录</summary><%- tocHtml %></details><% } %><div class="prose"><%- page.content %></div><div class="article-tags"><% page.tags.forEach(function(t){ %><a href="<%= url_for(t.path) %>"># <%= t.name %></a><% }) %></div><nav class="article-next"><% if(page.prev){ %><a href="<%= url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %><% if(page.next){ %><a href="<%= url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %></nav></article>

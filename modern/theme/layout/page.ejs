<section class="page-heading"><p class="eyebrow">HALO / <%= page.title || 'PAGE' %></p><h1><%= page.title || '页面' %></h1></section><% if(page.type==='categories' || page.path.startsWith('page/categories/')){ %><div class="taxonomy"><% site.categories.sort('name').forEach(function(c){ %><a href="<%= url_for(c.path) %>"><span><%= c.name %></span><span><%= c.length %></span></a><% }) %></div><% } else if(page.type==='tags' || page.path.startsWith('page/tags/')){ %><div class="tag-cloud"><% site.tags.sort('name').forEach(function(t){ %><a href="<%= url_for(t.path) %>"><%= t.name %> <small><%= t.length %></small></a><% }) %></div><% } else { %><div class="prose"><%- page.content %></div><% } %>

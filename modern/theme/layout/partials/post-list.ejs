<div class="post-list"><% posts.forEach(function(post){ %><article class="post-row"><div class="post-meta"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><% if(post.categories && post.categories.length){ %><span><%= post.categories.first().name %></span><% } %></div><div class="post-copy"><h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2><% if(post.description || post.summary){ %><p><%= strip_html(String(post.description || post.summary)).slice(0,140) %></p><% } %></div><a class="row-arrow" href="<%= url_for(post.path) %>" aria-label="阅读：<%= post.title %>">↗</a></article><% }) %></div>

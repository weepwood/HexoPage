<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"><title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title><meta name="description" content="<%= String(page.description || config.description || '').slice(0,180) %>"><link rel="canonical" href="<%= config.url.replace(/\/$/,'') + '/' + (page.path || '').replace(/index\.html$/,'') %>"><link rel="icon" href="<%= url_for('/favicon.svg') %>"><link rel="alternate" type="application/atom+xml" href="<%= url_for('/atom.xml') %>"><link rel="stylesheet" href="<%= url_for('/css/site.css') %>"><% if(page.mathjax){ %><link rel="stylesheet" href="<%= url_for('/vendor/katex/katex.min.css') %>"><script defer src="<%= url_for('/vendor/katex/katex.min.js') %>"></script><script defer src="<%= url_for('/vendor/katex/auto-render.min.js') %>"></script><script defer src="<%= url_for('/js/math.js') %>"></script><% } %><script defer src="<%= url_for('/js/site.js') %>"></script></head><body><a class="skip" href="#content">跳到正文</a><header class="top"><div class="nav"><a class="brand" href="<%= url_for('/') %>"><span class="brandmark" aria-hidden="true">H</span> HALO<span class="brand-dot">.</span></a><nav aria-label="主导航"><a href="<%= url_for('/archives/') %>">归档</a><a href="<%= url_for('/page/categories/') %>">分类</a><a href="<%= url_for('/page/tags/') %>">标签</a><a href="<%= url_for('/page/about/') %>">关于</a></nav><button class="icon-button" type="button" id="search-open" aria-label="搜索文章" title="搜索（Ctrl / ⌘ K）"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button class="icon-button" type="button" id="theme-toggle" aria-label="切换明暗主题"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M19 5l-2 2M7 17l-2 2"/></svg></button></div></header><main id="content" class="shell"><%- body %></main><footer class="footer"><div><strong>HALO.</strong><span>阅读、思考与技术记录</span></div><div><a href="<%= url_for('/page/about/') %>">关于</a><a href="<%= url_for('/atom.xml') %>">RSS</a><a href="<%= config.history_url %>">历史版本</a><a href="https://github.com/weepwood/HexoPage">GitHub</a></div></footer><dialog id="search-dialog" data-index="<%= url_for('/search-index.json') %>"><form method="dialog" class="search-head"><input id="search-input" type="search" placeholder="搜索标题、分类、标签…" aria-label="搜索文章" autocomplete="off"><button class="icon-button" aria-label="关闭搜索">✕</button></form><p class="search-status" role="status" id="search-status">输入关键词开始搜索</p><div id="search-results"></div></dialog></body></html>
